# Browser-visible Supabase Auth settings only (publishable key, never service_role)
NEXT_PUBLIC_SUPABASE_URL=https://uunfgimtokhucegqbpce.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI public base URL
NEXT_PUBLIC_MOREAI_API_URL=http://localhost:8000
# Optional dedicated origins. Leave blank to share NEXT_PUBLIC_MOREAI_API_URL.
NEXT_PUBLIC_MOREAI_CUSTOMER_API_URL=
NEXT_PUBLIC_MOREAI_PARTNER_API_URL=

# FastAPI server-only environment (never prefix with NEXT_PUBLIC_)
# Comma-separated exact frontend origins only when Customer/Partner use separate hosts.
MOREAI_CORS_ALLOWED_ORIGINS=http://localhost:3000
SUPABASE_URL=https://uunfgimtokhucegqbpce.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MOREAI_AGENT_EXECUTION_ENABLED=false

# Worker server-only environment. Keep disabled until routing, entitlement, quota,
# wallet, credit conversion and sandbox release gates have been validated.
WORKER_ID=moreai-worker-local-01
MOREAI_AGENT_RUNTIME_ENABLED=false
# Maximum wall-clock time for one durable agent run (30..7200 seconds).
MOREAI_RUN_TIMEOUT_SECONDS=1800
MOREAI_SANDBOX_ENABLED=false
MOREAI_SANDBOX_RELEASE_GATE_PASSED=false
# Set only to a reviewed, immutable image reference ending in @sha256:<64 hex chars>.
MOREAI_SANDBOX_IMAGE=
MOREAI_CREDITS_PER_USD=
MOREAI_CREDIT_WALLET_CURRENCY=
MOREAI_LLM_ENTITLEMENT_KEY=
MOREAI_LLM_QUOTA_METRIC_KEY=
# Example only: MOREAI_PROVIDER_<PROVIDER_KEY>_API_KEY=

# Per-invocation deadline for policy-registered OpenManus tools (1..1800 seconds).
MOREAI_TOOL_TIMEOUT_SECONDS=120

# HTTP request deadline for OpenAI-compatible provider adapters (1..600 seconds).
MOREAI_PROVIDER_TIMEOUT_SECONDS=90


# Browser supervisor (disabled until a private service network and egress gate are verified)
MOREAI_BROWSER_ENABLED=false
MOREAI_BROWSER_SERVICE_URL=
MOREAI_BROWSER_SERVICE_TOKEN=
MOREAI_BROWSER_EGRESS_ENFORCED=false
# Set true only when worker and browser-supervisor share a private Docker network.
# This permits HTTP only to http://browser-supervisor:8080, never arbitrary hosts.
MOREAI_BROWSER_PRIVATE_NETWORK_HTTP=false
MOREAI_BROWSER_PROXY_URL=
MOREAI_BROWSER_PROXY_TOKEN=
MOREAI_BROWSER_ALLOWED_DOMAINS=


# Google Connections Center (FastAPI only; never expose client secret or encryption key to browser)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/customer/connections/google/callback
MOREAI_CUSTOMER_APP_URL=https://app.example.com
# JSON map of retained key versions to base64url 32-byte keys; keep old keys until all credentials are re-encrypted.
MOREAI_CONNECTIONS_ENCRYPTION_KEYS=
MOREAI_CONNECTIONS_ACTIVE_KEY_VERSION=1
# Legacy single-key fallback (version 1 only).
MOREAI_CONNECTIONS_ENCRYPTION_KEY=


# Worker-to-FastAPI internal integration for owner-bound OpenFuse Google read tools
MOREAI_INTERNAL_API_URL=http://api:8000
MOREAI_WORKER_INTERNAL_TOKEN=
