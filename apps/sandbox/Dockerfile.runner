FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 65534 --no-create-home --shell /usr/sbin/nologin runner
USER 65534:65534
WORKDIR /tmp
# DockerSandbox supplies either: python -I -  OR bash --noprofile --norc
# Source is streamed over stdin; no source is baked into this image.
