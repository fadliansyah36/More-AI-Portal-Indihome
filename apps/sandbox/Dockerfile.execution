FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends docker.io ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi==0.115.12 uvicorn==0.34.0
COPY app /srv/app
EXPOSE 8080
# This service is a trusted execution boundary. It must be private-network-only,
# authenticated, and connected to a restricted Docker socket proxy, never public.
CMD ["uvicorn","app.execution_supervisor:app","--host","0.0.0.0","--port","8080"]
